[Unit]
Description=zkperf DA51 — perf trace → DA51 CBOR shard service
After=network.target rabbitmq-server.service
Wants=rabbitmq-server.service

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/var/lib/zkperf

# Watch for new perf.data files and emit the existing DA51 CBOR shard format.
# The CBOR DA51 marker is a payload/framing convention; it is not by itself a
# 64-bit DA51 address. Canonical 0xDA51[16|4|44] identities are validated by
# the zkperf::da51 codec / zkperf-da51 inspector and are attached explicitly.
ExecStart=/opt/zkperf/bin/zkperf-record watch /var/lib/zkperf/incoming /var/lib/zkperf/shards

Restart=always
RestartSec=5

Environment=ZKPERF_SHARD_DIR=/var/lib/zkperf/shards
Environment=ZKPERF_INCOMING=/var/lib/zkperf/incoming
Environment=AMQP_URL=amqp://localhost:5672
Environment=RUST_LOG=info

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zkperf

[Install]
WantedBy=multi-user.target
